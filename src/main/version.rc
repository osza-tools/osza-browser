#include "winver.h"
#include "veexversion.h"

IDI_ICON1 ICON DISCARDABLE "..\lib\data\icons\exeicons\veex.ico"
IDI_ICON2 ICON DISCARDABLE "..\lib\data\icons\exeicons\page.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VEEX_VERSION_MAJOR,VEEX_VERSION_MINOR,VEEX_VERSION_PATCH,0
 PRODUCTVERSION VEEX_VERSION_MAJOR,VEEX_VERSION_MINOR,VEEX_VERSION_PATCH,0
 FILEFLAGS 0x0L
 FILEFLAGSMASK 0x3fL
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "Veex Tools"
            VALUE "FileDescription", "Veex"
            VALUE "FileVersion", VEEX_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (C) 2010-2018 David Rosca"
            VALUE "InternalName", "veex"
            VALUE "OriginalFilename", "veex.exe"
            VALUE "ProductName", "Veex"
            VALUE "ProductVersion", VEEX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
