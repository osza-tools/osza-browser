#include "winver.h"
#include "oszaversion.h"

IDI_ICON1 ICON DISCARDABLE "..\lib\data\icons\exeicons\osza.ico"
IDI_ICON2 ICON DISCARDABLE "..\lib\data\icons\exeicons\page.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OSZA_VERSION_MAJOR,OSZA_VERSION_MINOR,OSZA_VERSION_PATCH,0
 PRODUCTVERSION OSZA_VERSION_MAJOR,OSZA_VERSION_MINOR,OSZA_VERSION_PATCH,0
 FILEFLAGS 0x0L
 FILEFLAGSMASK 0x3fL
 FILEOS 0x00040004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "Osza Tools"
            VALUE "FileDescription", "Osza"
            VALUE "FileVersion", OSZA_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (C) 2010-2018 David Rosca"
            VALUE "InternalName", "osza"
            VALUE "OriginalFilename", "osza.exe"
            VALUE "ProductName", "Osza"
            VALUE "ProductVersion", OSZA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
