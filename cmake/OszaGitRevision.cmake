# Regenerates src/osza_git_revision.h at build time.
#
# The revision used to be baked into config.h at configure time, so every
# "cmake .. && make" after a commit rewrote a header that ~25 objects on the
# lib side and every single plugin include - a one-line change could rebuild
# a third of the tree just because the commit had landed. The revision now
# lives in a header of its own, refreshed by this script on every build and
# rewritten only when the revision actually changed: an unchanged revision
# never dirties the tree, and a changed one rebuilds exactly the two objects
# that display it (aboutdialog.cpp and oszaschemehandler.cpp).
#
# Invoked as:
#   cmake -DGIT_EXECUTABLE=<git|empty>
#         -DSOURCE_DIR=<CMAKE_SOURCE_DIR>
#         -DOUTPUT_FILE=<CMAKE_BINARY_DIR>/src/osza_git_revision.h
#         -P cmake/OszaGitRevision.cmake

set(_content [[// Generated by cmake/OszaGitRevision.cmake at build time. Do not edit.
#ifndef OSZA_GIT_REVISION_H
#define OSZA_GIT_REVISION_H
]])

set(_revision "")
if(EXISTS "${SOURCE_DIR}/.git" AND GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _raw
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _git_result
    )
    if(_git_result EQUAL 0 AND NOT _raw STREQUAL "")
        set(_revision "${_raw}")
    endif()
endif()

if(_revision STREQUAL "")
    string(APPEND _content "// Built outside a git repository, or git could not be run.\n")
else()
    string(APPEND _content "#define OSZA_GIT_REVISION \"${_revision}\"\n")
endif()

string(APPEND _content "#endif // OSZA_GIT_REVISION_H\n")

# Write only when the content differs, so the file's timestamp - and with it
# every object that includes it - stays untouched between builds.
if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" _existing)
    if(_existing STREQUAL _content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT_FILE}" "${_content}")
